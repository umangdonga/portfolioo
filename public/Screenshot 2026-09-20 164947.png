<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 700" width="100%" height="100%">
  <!-- White Canvas -->
  <rect width="1000" height="700" fill="#ffffff" />

  <!-- Outer Double Red Border Frame (Top, Right, Bottom-Right) -->
  <rect x="20" y="20" width="960" height="660" rx="16" fill="none" stroke="#dc2626" stroke-width="2.5" />
  <rect x="26" y="26" width="948" height="648" rx="12" fill="none" stroke="#f87171" stroke-width="1" />

  <!-- Top-Left Spoken Tutorial Grey Wing Graphic -->
  <path d="M0,0 L200,0 L120,240 L0,240 Z" fill="#9ca3af" opacity="0.4" />
  <path d="M0,30 L220,30 C180,100 160,180 130,260 L0,260 Z" fill="#4b5563" opacity="0.15" />

  <!-- Circular Spoken Tutorial Logo Emblem -->
  <g transform="translate(80, 110)">
    <circle cx="0" cy="0" r="52" fill="#ffffff" stroke="#d1d5db" stroke-width="2" />
    <!-- Orange & Black Dual Crescent Logo -->
    <path d="M-22,-32 C-2,-42 24,-24 24,0 C24,18 6,32 -16,28 C-34,24 -40,0 -22,-32 Z" fill="#ea580c" />
    <circle cx="0" cy="0" r="30" fill="#18181b" />
    <path d="M-10,-20 C5,-30 22,-12 18,8 C14,24 -4,28 -18,18 Z" fill="#ea580c" />
    <path d="M-6,-12 C6,-18 16,-6 12,6 C8,16 -2,18 -10,10 Z" fill="#ffffff" />

    <text x="0" y="72" font-family="'Inter', sans-serif" font-size="11" font-weight="600" fill="#1f2937" text-anchor="middle">Spoken Tutorial</text>
    <text x="0" y="86" font-family="'Inter', sans-serif" font-size="10" fill="#4b5563" text-anchor="middle">Project at</text>
    <text x="0" y="100" font-family="'Inter', sans-serif" font-size="11" font-weight="bold" fill="#1f2937" text-anchor="middle">IIT Bombay</text>
  </g>

  <!-- Certificate Title Header -->
  <g transform="translate(520, 110)">
    <text x="0" y="0" font-family="'Inter', sans-serif" font-size="28" font-weight="400" fill="#111827" text-anchor="middle" letter-spacing="0.5">Certificate for the Completion of</text>
    <text x="0" y="38" font-family="'Inter', sans-serif" font-size="32" font-weight="700" fill="#111827" text-anchor="middle">Python 3.4.3 Training</text>
  </g>

  <!-- Body Content -->
  <g transform="translate(110, 240)">
    <text font-family="'Inter', sans-serif" font-size="17" fill="#1f2937" line-height="1.7">
      <tspan x="0" dy="0">This is to certify that </tspan>
      <tspan font-weight="bold">DONGA UMANG</tspan>
      <tspan> has successfully completed </tspan>
      <tspan font-weight="bold">Python 3.4.3</tspan>
      <tspan> test organized at </tspan>
      <tspan font-weight="bold">Silver</tspan>
      <tspan x="0" dy="28" font-weight="bold">Oak College of Computer Application </tspan>
      <tspan>by </tspan>
      <tspan font-weight="bold">Akshaybhai Parmar</tspan>
      <tspan> with course material provided by the</tspan>
      <tspan x="0" dy="28">Spoken Tutorial Project, IIT Bombay. Passing an online exam, conducted remotely from IIT Bombay, is a</tspan>
      <tspan x="0" dy="28">pre-requisite for completing this training.</tspan>
      <tspan x="0" dy="38" font-weight="bold">Alaap Jagdale</tspan>
      <tspan> from </tspan>
      <tspan font-weight="bold">Silver Oak College of Computer Application</tspan>
      <tspan> invigilated this examination. This</tspan>
      <tspan x="0" dy="28">training is offered by the Spoken Tutorial Project, IIT Bombay.</tspan>
    </text>
  </g>

  <!-- Exam Results & Score Badges -->
  <g transform="translate(500, 445)">
    <rect x="-180" y="-20" width="360" height="42" rx="21" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1.5" />
    <text x="-80" y="7" font-family="'Inter', sans-serif" font-size="16" font-weight="bold" fill="#0f172a" text-anchor="middle">
      Credits: <tspan fill="#ea580c">4</tspan>
    </text>
    <line x1="0" y1="-10" x2="0" y2="15" stroke="#cbd5e1" stroke-width="1.5" />
    <text x="80" y="7" font-family="'Inter', sans-serif" font-size="16" font-weight="bold" fill="#0f172a" text-anchor="middle">
      Score: <tspan fill="#16a34a">81.43%</tspan>
    </text>
  </g>

  <!-- Issue Date & Professor Signature -->
  <g transform="translate(120, 545)">
    <text x="0" y="30" font-family="'Inter', sans-serif" font-size="20" font-weight="500" fill="#111827">October 24th 2024</text>
  </g>

  <g transform="translate(780, 520)">
    <!-- Prof. Kannan Signature Vector -->
    <path d="M-60,25 C-40,5 -20,28 0,10 C20,30 40,5 60,25 C75,10 90,15 105,25" fill="none" stroke="#111827" stroke-width="2.5" stroke-linecap="round" />
    <path d="M-10,22 L80,18" stroke="#111827" stroke-width="1.5" />
    
    <text x="25" y="44" font-family="'Inter', sans-serif" font-size="13" font-weight="bold" fill="#111827" text-anchor="middle">Prof. Kannan M Moudgalya</text>
    <text x="25" y="62" font-family="'Inter', sans-serif" font-size="12" font-weight="600" fill="#374151" text-anchor="middle">IIT Bombay</text>
  </g>

  <!-- Credential Barcode / Serial ID (Bottom-Left) -->
  <text x="35" y="675" font-family="'JetBrains Mono', monospace" font-size="10" fill="#6b7280">3825388LTS</text>

  <!-- Bottom Disclaimer -->
  <g transform="translate(500, 645)">
    <text font-family="'Inter', sans-serif" font-size="8.5" fill="#6b7280" text-anchor="middle">
      <tspan x="0" dy="0">Credits for the Spoken Tutorial courses are based on our estimates of the work required to complete them. Recipient institutions are required</tspan>
      <tspan x="0" dy="12">to apply due diligence and get them ratified/modified by their own duly formed academic/assessment body. Spoken Tutorial is a project at IIT</tspan>
      <tspan x="0" dy="12">Bombay, started with funding from the National Mission on Education through ICT, Ministry of Education (previously MHRD), Govt. of India.</tspan>
    </text>
  </g>
</svg>
